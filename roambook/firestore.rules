rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validVisit() {
      let d = request.resource.data;
      return d.keys().hasAll(['type','name','country','state','status','date','trip','notes'])
        && d.keys().hasOnly(['type','name','country','state','status','date','trip','notes'])
        && d.type in ['country','state','city','national-park','state-park']
        && d.status in ['visited','wishlist','transit']
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.country is string && d.country.matches('^[A-Z]{2}$')
        && d.state is string && d.state.size() <= 80
        && d.date is string && (d.date == '' || d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && d.trip is string && d.trip.size() <= 100
        && d.notes is string && d.notes.size() <= 2000
        && (!(d.type in ['state','national-park','state-park']) || d.country == 'US')
        && (d.country != 'US' || d.type == 'country' || d.state.size() > 0);
    }
    match /users/{uid}/visits/{visitId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && validVisit();
    }
  }
}
